{
  "name": "acme-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter @acme/api db:setup",
    "preflight": "node scripts/preflight.mjs",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:seed": "pnpm --filter @acme/api db:seed",
    "db:reset": "pnpm --filter @acme/api db:reset"
  }
}
